<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="20dp" android:background="@color/cream">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:title="Smart Pantry Manager" android:background="@color/green_primary" android:titleTextColor="@android:color/white"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Settings" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/green_dark"/>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchExpiry"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="Enable expiring-soon alerts" android:checked="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="This setting is stored locally on the device." android:textColor="@color/text_muted"/>
</LinearLayout>
