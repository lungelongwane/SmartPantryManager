<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center"
    android:background="@color/cream">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:title="Smart Pantry Manager" android:background="@color/green_primary" android:titleTextColor="@android:color/white"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Smart Pantry Manager" android:textSize="30sp" android:textStyle="bold"
        android:textColor="@color/green_dark"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Cook what you already have. Reduce food waste."
        android:textSize="16sp" android:textColor="@color/text_muted" android:gravity="center"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPantry" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="32dp" android:text="My Pantry"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSuggestions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Suggested Recipes"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Settings"/>
</LinearLayout>
